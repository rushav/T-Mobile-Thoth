# Copy this file to `.env` (same directory) and fill in your own values.
# Never commit `.env` — it's gitignored for a reason.

# Required: Anthropic API key, starts with sk-ant-...
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides (leave commented unless you know why you're changing them)
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# CLAUDE_MODEL=claude-sonnet-4-20250514
# CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001
# CLAUDE_QUALITY_MODEL=claude-sonnet-4-20250514

# Required for the /api/v1 benchmark API. The benchmark evaluator calls our
# endpoints with `Authorization: Bearer <BENCHMARK_API_KEY>`. Pick any string,
# share it with whoever is running the eval.
BENCHMARK_API_KEY=replace-with-a-shared-secret
